OPENROUTER_API_KEY=sk-or-v1-...
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
CLOUDFLARE_TUNNEL_TOKEN=eyJ...
MODEL=anthropic/claude-haiku-4-5-20251001
SYSTEM_PROMPT=You are a helpful assistant accessed via LINE messaging app. Keep replies concise (under 500 words).

# --- Approach C: Claude Code native (optional) ---
# Set CLAUDE_MODE=true to route all messages through the local claude binary
# instead of OpenRouter. Gives Claude full file access, bash, MCP tools.
# Run the bridge on the HOST (not Docker) when using this mode.
CLAUDE_MODE=false
CLAUDE_CWD=/home/youruser/projects
MEMORY_ENABLED=false
MEM_CLI=/home/youruser/projects/openmemory/scripts/mem
# Comma-separated LINE userIds allowed to use CLAUDE_MODE.
# Get your userId from: docker compose logs bridge | grep user_id_hash
# (it's hashed in logs — get the real one from LINE Developers Console → Users tab)
CLAUDE_ALLOWED_USERS=Uyour_line_user_id_here
# Your LINE userId: only your own 1:1 chat gets tools, MCP and memory.
# Every other chat runs an isolated, answer-only claude (see README "Shared chats").
CLAUDE_OWNER_USER_ID=
# Token from `claude setup-token` for shared chats. Never name it CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_SHARED_OAUTH_TOKEN=
# Empty home/config dir for shared runs; defaults to ~/.local/state/line-claude-bridge/shared
# CLAUDE_SHARED_DIR=
